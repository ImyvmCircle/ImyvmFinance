# Copy to the server config directory as imyvm_finance.properties.
market.connect-timeout-ms=1000
market.read-timeout-ms=2000
market.holidays.CN=
market.enabled.CN=true
market.enabled.CRYPTO=true
market.providers.CN=eastmoney,sina,tencent
market.providers.CRYPTO=binance,mexc,bitget
market.disabled-providers=
quote.poll-interval-minutes=3
quote.poll-delay-seconds=17
quote.jitter-seconds=15
quote.provider-backoff-minutes=15
quote.random-seed=0
simulation.default-model=empirical-regime-v1
briefing.interval-minutes=15
briefing.delay-seconds=20
briefing.enabled=true
language=zh_cn
trading.max-quote-age-minutes=15
trading.sell-cooldown-minutes=30
trading.fee-bps=20
trading.base-slippage-bps=10
trading.daily-buy-limit=100000
trading.daily-sell-limit=100000
trading.position-value-limit=300000
trading.min-units=1
