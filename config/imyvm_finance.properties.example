# Copy to the server config directory as imyvm_finance.properties.
sidecar.endpoint=http://127.0.0.1:8765/quotes
sidecar.connect-timeout-ms=1000
sidecar.read-timeout-ms=2000
sidecar.poll-interval-minutes=5
sidecar.poll-delay-seconds=17
briefing.interval-minutes=20
briefing.delay-seconds=20
briefing.enabled=true
language=zh_cn
trading.max-quote-age-minutes=15
trading.sell-cooldown-minutes=30
trading.fee-bps=20
trading.base-slippage-bps=10
trading.daily-buy-limit=100000
trading.daily-sell-limit=100000
trading.position-value-limit=300000
trading.min-units=1
